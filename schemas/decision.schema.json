{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trustgate.dev/v1.0.0/decision.schema.json",
  "title": "Trust Gate Contextual Decision",
  "description": "A deterministic decision with its complete evidence and policy snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "finding_id",
    "outcome",
    "policy",
    "context",
    "explanation",
    "evidence_strength",
    "unresolved_uncertainty",
    "evaluation_trace",
    "reproduction_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "decision_id": {"$ref": "#/$defs/digest"},
    "finding_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "outcome": {"$ref": "#/$defs/outcome"},
    "policy": {"$ref": "#/$defs/appliedPolicy"},
    "context": {"$ref": "#/$defs/context"},
    "explanation": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_strength": {"$ref": "#/$defs/evidenceStrength"},
    "unresolved_uncertainty": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/componentName"}
    },
    "evaluation_trace": {
      "type": "array",
      "items": {"$ref": "#/$defs/ruleEvaluation"}
    },
    "reproduction_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "BLOCK_IMMEDIATELY",
        "FIX_BEFORE_RELEASE",
        "FIX_WITHIN_SLA",
        "INVESTIGATE",
        "MONITOR",
        "TEMPORARILY_SUPPRESSED",
        "ACCEPTED_RISK",
        "LIKELY_NOISE",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "componentName": {
      "type": "string",
      "enum": [
        "finding_validity_confidence",
        "original_severity",
        "normalised_severity",
        "reachability",
        "epss",
        "cisa_kev",
        "public_exploit_availability",
        "internet_exposure",
        "authentication_requirements",
        "data_sensitivity",
        "asset_criticality",
        "runtime_environment",
        "existing_controls",
        "fix_availability",
        "new_existing_status",
        "human_triage_state"
      ]
    },
    "scalar": {
      "type": ["string", "number", "integer", "boolean", "null"]
    },
    "componentValue": {
      "oneOf": [
        {"$ref": "#/$defs/scalar"},
        {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scalar"}
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence", "uncertainty"],
      "properties": {
        "value": {"$ref": "#/$defs/componentValue"},
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "uncertainty": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_validity_confidence",
        "original_severity",
        "normalised_severity",
        "reachability",
        "epss",
        "cisa_kev",
        "public_exploit_availability",
        "internet_exposure",
        "authentication_requirements",
        "data_sensitivity",
        "asset_criticality",
        "runtime_environment",
        "existing_controls",
        "fix_availability",
        "new_existing_status",
        "human_triage_state"
      ],
      "properties": {
        "finding_validity_confidence": {"$ref": "#/$defs/component"},
        "original_severity": {"$ref": "#/$defs/component"},
        "normalised_severity": {"$ref": "#/$defs/component"},
        "reachability": {"$ref": "#/$defs/component"},
        "epss": {"$ref": "#/$defs/component"},
        "cisa_kev": {"$ref": "#/$defs/component"},
        "public_exploit_availability": {"$ref": "#/$defs/component"},
        "internet_exposure": {"$ref": "#/$defs/component"},
        "authentication_requirements": {"$ref": "#/$defs/component"},
        "data_sensitivity": {"$ref": "#/$defs/component"},
        "asset_criticality": {"$ref": "#/$defs/component"},
        "runtime_environment": {"$ref": "#/$defs/component"},
        "existing_controls": {"$ref": "#/$defs/component"},
        "fix_availability": {"$ref": "#/$defs/component"},
        "new_existing_status": {"$ref": "#/$defs/component"},
        "human_triage_state": {"$ref": "#/$defs/component"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "components"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "components": {"$ref": "#/$defs/components"}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "operator", "expected"],
      "properties": {
        "component": {"$ref": "#/$defs/componentName"},
        "operator": {
          "type": "string",
          "enum": ["equals", "not_equals", "in", "gte", "lte", "contains", "is_known"]
        },
        "expected": {"$ref": "#/$defs/componentValue"}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "outcome", "conditions", "explanation"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "outcome": {"$ref": "#/$defs/outcome"},
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/condition"}
        },
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "policySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "version", "rules", "default_outcome"],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
        "default_outcome": {"$ref": "#/$defs/outcome"}
      }
    },
    "appliedPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "matched_rule_id", "snapshot"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "matched_rule_id": {"type": ["string", "null"], "minLength": 1},
        "snapshot": {"$ref": "#/$defs/policySnapshot"}
      }
    },
    "evidenceStrength": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "known_components",
        "total_components",
        "finding_validity_lower_bound"
      ],
      "properties": {
        "level": {"type": "string", "enum": ["strong", "moderate", "weak", "insufficient"]},
        "known_components": {"type": "integer", "minimum": 0, "maximum": 16},
        "total_components": {"const": 16},
        "finding_validity_lower_bound": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "conditionEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "operator", "expected", "actual", "matched"],
      "properties": {
        "component": {"$ref": "#/$defs/componentName"},
        "operator": {
          "type": "string",
          "enum": ["equals", "not_equals", "in", "gte", "lte", "contains", "is_known"]
        },
        "expected": {"$ref": "#/$defs/componentValue"},
        "actual": {"$ref": "#/$defs/componentValue"},
        "matched": {"type": "boolean"}
      }
    },
    "ruleEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "outcome", "matched", "conditions"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "outcome": {"$ref": "#/$defs/outcome"},
        "matched": {"type": "boolean"},
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/conditionEvaluation"}
        }
      }
    }
  }
}
