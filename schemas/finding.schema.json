{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trustgate.dev/v1.0.0/finding.schema.json",
  "title": "Trust Gate Finding",
  "description": "Canonical, audit-ready representation of one security finding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "fingerprint",
    "scanner",
    "scanner_version",
    "rule_id",
    "rule_version",
    "category",
    "cwe",
    "cve",
    "ghsa",
    "osv",
    "title",
    "description",
    "original_severity",
    "normalised_severity",
    "severity_reason",
    "confidence",
    "confidence_method",
    "confidence_sample_size",
    "confidence_interval",
    "file",
    "start_line",
    "end_line",
    "symbol",
    "source",
    "sink",
    "data_flow",
    "dependency",
    "dependency_scope",
    "reachability",
    "environment",
    "introduced_commit",
    "first_seen",
    "last_seen",
    "status",
    "evidence",
    "remediation",
    "raw_report_reference"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "description": "Semantic version of this finding contract."
    },
    "finding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "scanner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scanner_version": {
      "$ref": "#/$defs/nullableNonEmptyString"
    },
    "rule_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "rule_version": {
      "$ref": "#/$defs/nullableNonEmptyString"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "cwe": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CWE-[1-9][0-9]*$"
      }
    },
    "cve": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"
      }
    },
    "ghsa": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^GHSA-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}-[A-Za-z0-9]{4}$"
      }
    },
    "osv": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "threat_intelligence": {
      "$ref": "#/$defs/threatIntelligence"
    },
    "dependency_reachability": {
      "$ref": "#/$defs/dependencyReachability"
    },
    "source_to_sink_analysis": {
      "$ref": "#/$defs/sourceToSinkAnalysis"
    },
    "dynamic_correlation": {
      "$ref": "#/$defs/dynamicCorrelation"
    },
    "contextual_decision": {
      "$ref": "decision.schema.json"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "description": {
      "type": "string"
    },
    "original_severity": {
      "$ref": "#/$defs/nullableNonEmptyString"
    },
    "normalised_severity": {
      "$ref": "#/$defs/severity"
    },
    "severity_reason": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "confidence_method": {
      "$ref": "#/$defs/nullableNonEmptyString"
    },
    "confidence_sample_size": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "confidence_interval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/confidenceInterval"
        }
      ]
    },
    "scanner_rule_reliability": {
      "$ref": "#/$defs/confidenceComponent"
    },
    "finding_validity_confidence": {
      "$ref": "#/$defs/confidenceComponent"
    },
    "reachability_confidence": {
      "$ref": "#/$defs/confidenceComponent"
    },
    "exploitability_confidence": {
      "$ref": "#/$defs/confidenceComponent"
    },
    "remediation_confidence": {
      "$ref": "#/$defs/confidenceComponent"
    },
    "overall_decision_confidence": {
      "$ref": "#/$defs/confidenceComponent"
    },
    "file": {
      "$ref": "#/$defs/nullableString"
    },
    "start_line": {
      "$ref": "#/$defs/nullableLine"
    },
    "end_line": {
      "$ref": "#/$defs/nullableLine"
    },
    "symbol": {
      "$ref": "#/$defs/nullableString"
    },
    "source": {
      "$ref": "#/$defs/nullableString"
    },
    "sink": {
      "$ref": "#/$defs/nullableString"
    },
    "data_flow": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataFlowStep"
      }
    },
    "dependency": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/dependency"
        }
      ]
    },
    "dependency_scope": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "runtime",
        "development",
        "test",
        "build",
        "optional",
        "unknown",
        null
      ]
    },
    "reachability": {
      "type": "string",
      "enum": [
        "reachable",
        "potentially_reachable",
        "unreachable",
        "unknown",
        "not_applicable"
      ]
    },
    "environment": {
      "type": "object",
      "description": "Execution-environment attributes. Values are deliberately limited to JSON scalar data.",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    },
    "introduced_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{7,64}$"
    },
    "first_seen": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "$ref": "#/$defs/findingState"
    },
    "state_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stateTransition"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "remediation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/remediation"
        }
      ]
    },
    "raw_report_reference": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/rawReportReference"
        }
      ]
    },
    "occurrence_count": {
      "type": "integer",
      "minimum": 1
    },
    "locations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/findingLocation"
      }
    },
    "raw_evidence_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/rawReportReference"
      }
    },
    "source_finding_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supporting_scanners": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contradicting_scanners": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "agreement_strength": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "correlation_reason": {
      "type": "string",
      "minLength": 1
    },
    "correlation_signals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "cwe",
          "file",
          "symbol",
          "source",
          "sink",
          "code_region",
          "dependency",
          "cve",
          "infrastructure_resource",
          "secret_fingerprint"
        ]
      }
    },
    "corroboration": {
      "$ref": "#/$defs/corroboration"
    },
    "code_region_hash": {
      "$ref": "#/$defs/nullableNonEmptyString"
    },
    "infrastructure_resource": {
      "$ref": "#/$defs/nullableNonEmptyString"
    },
    "secret_fingerprint": {
      "$ref": "#/$defs/nullableNonEmptyString"
    },
    "rule_ancestry": {
      "$ref": "#/$defs/nullableNonEmptyString"
    }
  },
  "$defs": {
    "lifecycleEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference",
        "summary"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lifecycleApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "timestamp",
        "reason"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "from_state",
        "to_state",
        "actor",
        "timestamp",
        "reason",
        "evidence",
        "approval",
        "expires_at",
        "automatic"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "from_state": {
          "$ref": "#/$defs/findingState"
        },
        "to_state": {
          "$ref": "#/$defs/findingState"
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifecycleEvidence"
          }
        },
        "approval": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/lifecycleApproval"
            }
          ]
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "automatic": {
          "type": "boolean"
        }
      }
    },
    "findingState": {
      "type": "string",
      "enum": [
        "open",
        "acknowledged",
        "suppressed",
        "resolved",
        "false_positive",
        "accepted_risk"
      ]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullableNonEmptyString": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "nullableLine": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info",
        "unknown"
      ]
    },
    "confidenceInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper",
        "confidence_level"
      ],
      "properties": {
        "lower": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "upper": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "confidenceComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimate",
        "conservative_bound",
        "sample_size",
        "method",
        "methodology_version",
        "evidence",
        "explanation",
        "maturity",
        "decision_tier"
      ],
      "properties": {
        "estimate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "conservative_bound": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "sample_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "methodology_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "maturity": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_tier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dataFlowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "kind",
        "file",
        "line",
        "symbol",
        "description"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "enum": [
            "source",
            "propagation",
            "sink"
          ]
        },
        "file": {
          "$ref": "#/$defs/nullableString"
        },
        "line": {
          "$ref": "#/$defs/nullableLine"
        },
        "symbol": {
          "$ref": "#/$defs/nullableString"
        },
        "description": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "ecosystem",
        "purl",
        "direct"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "ecosystem": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "purl": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "direct": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "threatIntelligence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_ids",
        "cvss_score",
        "cvss_vector",
        "epss_probability",
        "epss_percentile",
        "kev_status",
        "known_exploitation_date",
        "ransomware_association",
        "fixed_versions",
        "published_date",
        "modified_date",
        "data_source_timestamp",
        "network_mode",
        "stale",
        "risk_context_complete",
        "limitations",
        "sources",
        "failures"
      ],
      "properties": {
        "advisory_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "cvss_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 10
        },
        "cvss_vector": {
          "$ref": "#/$defs/nullableNonEmptyString"
        },
        "epss_probability": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "epss_percentile": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "kev_status": {
          "type": ["boolean", "null"]
        },
        "known_exploitation_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "ransomware_association": {
          "type": ["string", "null"],
          "enum": ["known", "unknown", null]
        },
        "fixed_versions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "published_date": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "modified_date": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "data_source_timestamp": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "network_mode": {
          "type": "string",
          "enum": ["disabled", "metadata-only", "full"]
        },
        "stale": {
          "type": "boolean"
        },
        "risk_context_complete": {
          "const": false
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/threatSource"
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/threatFailure"
          }
        }
      }
    },
    "threatSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "status",
        "fetched_at",
        "expires_at",
        "stale",
        "identifiers_sent"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "not-applicable",
            "cache-miss",
            "fresh-cache",
            "stale-cache",
            "refreshed",
            "failed",
            "not-needed"
          ]
        },
        "fetched_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "expires_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "stale": {
          "type": "boolean"
        },
        "identifiers_sent": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "threatFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "error"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "analysisEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "symbol", "description"],
      "properties": {
        "file": {"$ref": "#/$defs/nullableString"},
        "line": {"$ref": "#/$defs/nullableLine"},
        "symbol": {"$ref": "#/$defs/nullableString"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "reachabilityStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file", "line", "symbol", "description"],
      "properties": {
        "kind": {"type": "string", "enum": ["manifest", "import", "call"]},
        "file": {"$ref": "#/$defs/nullableString"},
        "line": {"$ref": "#/$defs/nullableLine"},
        "symbol": {"$ref": "#/$defs/nullableString"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "dependencyReachability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "package_installed", "dependency_relationship", "imported",
        "vulnerable_symbol_called", "dependency_scope",
        "included_in_deployed_artifact", "call_path_exists",
        "analysis_incomplete", "dynamic_behaviour_unknown",
        "analysed_call_path", "analysed_files", "limitations", "explanation"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "CONFIRMED_REACHABLE", "LIKELY_REACHABLE", "NO_PATH_FOUND",
            "NOT_ANALYSED", "ANALYSIS_INCOMPLETE", "DYNAMIC_BEHAVIOUR_UNKNOWN"
          ]
        },
        "package_installed": {"type": ["boolean", "null"]},
        "dependency_relationship": {
          "type": "string",
          "enum": ["direct", "transitive", "unknown", "not-applicable"]
        },
        "imported": {"type": ["boolean", "null"]},
        "vulnerable_symbol_called": {"type": ["boolean", "null"]},
        "dependency_scope": {
          "type": "string",
          "enum": [
            "runtime", "development", "test", "build", "optional", "unknown",
            "not-applicable"
          ]
        },
        "included_in_deployed_artifact": {"type": ["boolean", "null"]},
        "call_path_exists": {"type": ["boolean", "null"]},
        "analysis_incomplete": {"type": "boolean"},
        "dynamic_behaviour_unknown": {"type": "boolean"},
        "analysed_call_path": {
          "type": "array",
          "items": {"$ref": "#/$defs/reachabilityStep"}
        },
        "analysed_files": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "limitations": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "frameworkRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "methods", "file", "line", "handler"],
      "properties": {
        "endpoint": {"$ref": "#/$defs/nullableString"},
        "methods": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "file": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "handler": {"type": "string", "minLength": 1}
      }
    },
    "sourceToSinkAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support", "status", "analysis_incomplete", "identified_sources",
        "identified_sanitizers", "identified_sinks", "intra_file", "cross_file",
        "framework_routes", "authentication_required", "authorization_checks",
        "path_confidence", "evidence", "limitations"
      ],
      "properties": {
        "support": {"type": "string", "enum": ["supported", "unsupported", "incomplete"]},
        "status": {"type": "string", "enum": ["path-found", "no-path-found", "not-analysed"]},
        "analysis_incomplete": {"type": "boolean"},
        "identified_sources": {"type": "array", "items": {"$ref": "#/$defs/analysisEvidence"}},
        "identified_sanitizers": {"type": "array", "items": {"$ref": "#/$defs/analysisEvidence"}},
        "identified_sinks": {"type": "array", "items": {"$ref": "#/$defs/analysisEvidence"}},
        "intra_file": {"type": "boolean"},
        "cross_file": {"type": "boolean"},
        "framework_routes": {"type": "array", "items": {"$ref": "#/$defs/frameworkRoute"}},
        "authentication_required": {"type": ["boolean", "null"]},
        "authorization_checks": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "path_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/dataFlowStep"}},
        "limitations": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "failedReproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "evidence"],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "dynamicCorrelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "matched_observation_ids", "endpoint_matched",
        "parameter_matched", "sink_matched", "priority_adjustment",
        "priority_reason", "authentication_state", "failed_reproduction_attempts",
        "static_evidence", "runtime_evidence", "limitations"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["confirmed", "failed-reproduction", "blocked-authentication", "inconclusive", "not-attempted"]
        },
        "matched_observation_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "endpoint_matched": {"type": "boolean"},
        "parameter_matched": {"type": "boolean"},
        "sink_matched": {"type": "boolean"},
        "priority_adjustment": {"type": "string", "enum": ["increased", "unchanged"]},
        "priority_reason": {"type": "string", "minLength": 1},
        "authentication_state": {"type": "string", "minLength": 1},
        "failed_reproduction_attempts": {"type": "array", "items": {"$ref": "#/$defs/failedReproduction"}},
        "static_evidence": {"type": "array", "items": {"$ref": "#/$defs/dataFlowStep"}},
        "runtime_evidence": {"type": "array", "items": {"type": "string"}},
        "limitations": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary",
        "reference",
        "excerpt"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "$ref": "#/$defs/nullableString"
        },
        "reference": {
          "$ref": "#/$defs/nullableString"
        },
        "excerpt": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "guidance",
        "references"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "guidance": {
          "$ref": "#/$defs/nullableString"
        },
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "rawReportReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "scanner_finding_id"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scanner_finding_id": {
          "$ref": "#/$defs/nullableNonEmptyString"
        }
      }
    },
    "findingLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "start_line",
        "end_line",
        "symbol"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/nullableString"
        },
        "start_line": {
          "$ref": "#/$defs/nullableLine"
        },
        "end_line": {
          "$ref": "#/$defs/nullableLine"
        },
        "symbol": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "sharedRuleAncestry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ancestry",
        "scanners"
      ],
      "properties": {
        "ancestry": {
          "type": "string",
          "minLength": 1
        },
        "scanners": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "corroboration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "methodology_version",
        "independent_scanner_count",
        "independent_sources",
        "shared_rule_ancestry",
        "dast_confirmations",
        "human_confirmations",
        "supporting_evidence_count",
        "contradicting_evidence_count",
        "estimate",
        "conservative_bound",
        "confidence_interval",
        "explanation"
      ],
      "properties": {
        "method": {
          "const": "beta-binomial-independent-evidence"
        },
        "methodology_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "independent_scanner_count": {
          "type": "integer",
          "minimum": 1
        },
        "independent_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shared_rule_ancestry": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sharedRuleAncestry"
          }
        },
        "dast_confirmations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "human_confirmations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "supporting_evidence_count": {
          "type": "integer",
          "minimum": 1
        },
        "contradicting_evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "estimate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "conservative_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence_interval": {
          "$ref": "#/$defs/confidenceInterval"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
