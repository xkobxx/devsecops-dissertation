{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trustgate.dev/v1.0.0/suppression.schema.json",
  "title": "Trust Gate Finding Suppression",
  "description": "Content-bound, scoped, expiring authorization to suppress one finding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "suppression_id",
    "finding_fingerprint",
    "reason",
    "author",
    "created_at",
    "expires_at",
    "scope",
    "approval",
    "evidence",
    "revalidation_rule",
    "suppression_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "version": {"const": 1},
    "suppression_id": {
      "type": "string",
      "pattern": "^suppression-[0-9a-f]{24}$"
    },
    "finding_fingerprint": {"type": "string", "minLength": 1, "maxLength": 512},
    "reason": {"type": "string", "minLength": 1},
    "author": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "scope": {"$ref": "#/$defs/scope"},
    "approval": {"$ref": "#/$defs/approval"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "revalidation_rule": {"$ref": "#/$defs/revalidationRule"},
    "suppression_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branches", "paths", "environments"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "maxLength": 512},
        "branches": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        },
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        },
        "environments": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "timestamp", "reason"],
      "properties": {
        "actor": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "summary"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "revalidationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_region_hash",
        "reachability",
        "kev_status",
        "exploit_evidence_digest",
        "policy_digest"
      ],
      "properties": {
        "code_region_hash": {"type": ["string", "null"], "minLength": 1},
        "reachability": {
          "type": "string",
          "enum": [
            "reachable",
            "potentially_reachable",
            "unreachable",
            "unknown",
            "not_applicable"
          ]
        },
        "kev_status": {"type": ["boolean", "null"]},
        "exploit_evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
